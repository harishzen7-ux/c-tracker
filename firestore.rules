rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsernameKey(nameKey) {
      return nameKey is string && nameKey.size() >= 4 && nameKey.size() <= 20 && nameKey.matches('^[a-z][a-z0-9_]{3,19}$');
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['username', 'usernameLower', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.username.size() >= 4
        && request.resource.data.username.size() <= 20;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // --- USERNAMES INDEX COLLECTION ---
    match /usernames/{usernameLower} {
      // Anyone can check if a username exists during signup validation
      allow get: if true;
      allow list: if false;
      // Creation: must be authenticated and setting uid to their own auth.uid
      allow create: if isSignedIn()
        && isValidUsernameKey(usernameLower)
        && request.resource.data.keys().hasAll(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // --- USER PROGRESS SUBCOLLECTIONS ---
    match /progress/{userId} {
      allow get, list: if isOwner(userId);
      allow write: if isOwner(userId);

      match /topics/{topicId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(topicId);
        allow delete: if isOwner(userId);
      }

      match /code/{questionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(questionId)
          && request.resource.data.code is string
          && request.resource.data.code.size() <= 60000;
        allow delete: if isOwner(userId);
      }
    }
  }
}
